[Unit]
Description=Flask Web Application Server using Gunicorn
After=network.target

[Service]
User=slate
Group=www-data
WorkingDirectory=/home/slate/SLATE/app
Environment="PATH=/home/slate/SLATE/venv/bin"
#ExecStart=/bin/bash -c 'source /home/slate/SLATE/venv/activate; gunicorn -w 4 --bind 0.0.0.0:8000 slate:app'
ExecStart=/bin/bash -c 'source /home/slate/SLATE/venv/bin/activate; /home/slate/.local/bin/gunicorn -w 4 --bind 0.0.0.0:8000 slate:app'
Restart=always

[Install]
WantedBy=multi-user.target
