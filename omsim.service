[Unit]
Description=Flask Web Application Server using Gunicorn
After=network.target

[Service]
User=john
Group=www-data
WorkingDirectory=/home/john/OMSim/clscripts/omnet
Environment="PATH=/home/john/OMSim/clscripts/omnet/venv/bin"
ExecStart=/bin/bash -c 'source /home/john/OMSim/clscripts/omnet/venv/bin/activate; /home/john/OMSim/clscripts/omnet/venv/bin/gunicorn -w 4 --bind 0.0.0.0:8000 omnet:app'
#ExecStart=/bin/bash -c 'source /home/john/OMSim/clscripts/omnet/venv/bin/activate; /home/john/.local/bin/gunicorn -w 4 --bind 0.0.0.0:8000 omnet:app'
Restart=always

[Install]
WantedBy=multi-user.target

