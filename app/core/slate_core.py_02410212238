# Check whether entity is currently active:
def entity_is_active(entity_id):

    entity_fph, entity_hrns, entity_type, m = identify_entity(entity_id)
    if m:
        return "", "", "", False, m

    entity_fph, parent_namespace_fph, entity_type, \
    active, m = get_entity_common_properties(entity_id)
    return active, m

