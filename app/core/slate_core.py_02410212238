                                       initial_currency_fph
                                   )

    accounts_fph_list = pickle.dumps([account_fph])
    stewardships_fph_list = pickle.dumps([])

    access_token = generate_access_token()
    access_token_hash = auth_hash(access_token)

    add_entity_common_properties(
