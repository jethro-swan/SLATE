def list_primid_accounts(primid_fph):
    with sqlite3.connect(ENTITIES_DB) as conn:
        cursor = conn.cursor()
        cursor.execute(
            "SELECT accounts_fph_list FROM primids WHERE entity_fph = ?",
            (primid_fph,)
        )
        primid_properties = cursor.fetchone()
        cursor.close()
        if primid_properties is not None:
            accounts_fph_blob = primid_properties[0]
            if accounts_fph_blob is not None:
                accounts_fph_list = pickle.loads(accounts_fph_blob)
                return accounts_fph_list, ""    # list + message
            else:
                return [], "Accounts FPH list invalid"
        else:
            return [], "Agent properties list invalid"


