# This is used only when the primid is created. Subsequently, the primid update
# functions are used.

def add_primid_specific_properties(
        primid_fph,
        primid_realname,
        primid_email_1,
        primid_email_2,
        initial_account_hrns,           # HRNS of initial account
        initial_account_currency_fph,   # FPH of initial account's currency
        stewardship_fph,                # FPH for initial stewardship, if any.
        password,
        pin,
        access_token
    ):
    errors = ""
    if not re_fph.match(primid_fph):
        errors += primid_fph + " is not an FPH\n"
        return errors
    etype, m = get_entity_type(primid_fph)
    if m:
        errors += m + "\n"
    if etype != "primid":
        errors += primid_fph + " is not a primid\n"
        return errors
    needed = False
    insert_str = "INSERT INTO primids (entity_fph = ?, "
    places_str = "VALUES (?, "
    values_str = "(entity_fph, "
    if primid_realname and re_realname.match(primid_realname):
        insert_str += "primid_realname = ?, "
        places_str += "?, "
        values_str += "primid_realname, "
        needed = True
    else:
        errors += primid_realname + " is not a valid name\n"
    if primid_email_1 and re_email.match(primid_email_1):
        insert_str += "primid_email_1 = ?, "
        places_str += "?, "
        values_str += "primid_email_1, "
        needed = True
    else:
        errors += primid_email_1 + " is not a valid email address\n"
    if primid_email_2:
        if re_email.match(primid_email_2):
            insert_str += "primid_email_2 = ?, "
            places_str += "?, "
            values_str += "primid_email_2, "
            needed = True
        else:
            errors += primid_email_2 + " is not a valid email address\n"
    if password:
        password_hash = auth_hash(password)
        insert_str += "password_hash = ?, "
        places_str += "?, "
        values_str += "password_hash, "
        needed = True
    else:
        errors += password + " is not a valid password\n"
    if pin:
        if re_pin.match(pin):
            insert_str += "pin = ?, "
            places_str += "?, "
            values_str += "pin, "
            needed = True
        else:
            errors += pin + " is not a valid PIN\n"
    else:
        errors += "No PIN provided\n"
    if access_token:
        if re_access_token.match(access_token):
            access_token_hash = auth_hash(access_token)
            insert_str += "access_token_hash = ?, "
            places_str += "?, "
            values_str += "access_token_hash, "
            needed = True
        else:
            errors += access_token  + " is not a valid access token\n"
    else:
        errors += "No access token provided\n"
    # Add an initial account:
    account_created = False
    accounts_fph_list = []
    if re_hrns.match(initial_account_hrns):
        if re_fph.match(initial_account_currency_fph):
            etype, m = get_entity_type(initial_account_currency_fph)
            if etype == "currency":
                account_fph, account_hrns, m = new_account(
                                                   initial_account_hrns,
                                                   primid_fph,
                                                   initial_account_currency_fph
                                               )
                if m:
                    errors += m + "\n"
                else:
                    accounts_fph_list.append(account_fph)
                    accounts_fph_blob = pickle.dumps(accounts_fph_list)
                    insert_str += "accounts_fph_list ?, "
                    places_str += "?, "
                    values_str += "accounts_fph_blob, "
                    needed = True
                    account_created = True
            else:
                errors += initial_account_currency_fph + " is not a currency\n"
        else:
            errors += initial_account_currency_fph + " is not a valid FPH\n"
    if not account_created:
        errors += "Account " + initial_account_hrns + " in currency " \
               + initial_account_currency_fph + " could not be created. " \
               + "Therefore this agent (primid) currently has no accounts.\n"
    # Add an initial stewardship if required:
    if stewardship_fph:
        if re_fph.match(stewardship_fph):
            etype, m = get_entity_type(stewardship_fph)
            if m:
                errors += m
            if (etype == "namespace") or (etype == "currency"):
                # Only if this steward can be added for the specified entity
                # will this stewardship be added here:
                m = add_stewards(stewardship_fph, primid_fph) ##############
                if m:
                    errors += m
                    errors += stewardship_fph + " stewardship not added\n"
                else:
                    stewardships_fph_blob = pickle.dumps([stewardship_fph])
                    insert_str += "stewardships_fph_list = ?, "
                    places_str += "?, "
                    values_str += "stewardships_fph_blob, "
                    needed = True
            else:
                errors += stewardship_fph + " is " + etype \
                       + " so has no stewards\n"
        else:
            errors += stewardships_fph + " is not an FPH\n"
    if needed:
        insert_str += ") "
        insert_str = insert_str.replace(", ) ", ") ") # remove the final comma
        places_str += "), "
        places_str = places_str.replace(", ), ", "), ") # remove the final comma
        values_str += ")"
        values_str = values_str.replace(", )", ")") # remove the final comma
        sqlite_str = insert_str + places_str + values_str
        print("sqlite_str = " + sqlite_str)
        print("errors:\n" + errors)
        with sqlite3.connect(ENTITIES_DB) as conn:
            cursor = conn.cursor()
            cursor.execute(sqlite_str)
            conn.commit()
            cursor.close()
    else:
        errors += "No valid values were provided\n"
    return errors

