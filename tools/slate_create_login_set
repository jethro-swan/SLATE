import sys
import argparse
import math

from app.core.regexp_list import re_realname, re_slatename, re_email
from app.core.regexp_list import re_password, re_pin
from app.core.fph_hrns_maps import hrns_to_fph
from app.core.slate_core import identify_entity
#from app.core.fph_hrns_maps import record_private_namespace_root
from app.core.slate_core import record_private_namespace_root
from app.core.slate_core import new_primid
from app.core.slate_core import get_hub_mode
from app.core.slate_core import new_pairing

em1 = "nobody@nowhere.org" # dummy recovery email

ap = argparse.ArgumentParser(description = "Create a set of login identities")
ap.add_argument(
    "-u", "--login-name-prefix", dest = "login_name_prefix", action = "store",
    help = "Login name"
)
ap.add_argument(
    "-n", "--number-of-primids", dest = "number_of_primids", action = "store",
    default = 10,
    help = "number of login identiies to be created"
)
ap.add_argument(
    "-s", "--registration_namespace", dest = "namespace", action = "store",
    help = "Registration namespace"
)
ap.add_argument(
    "-c", "--currency", dest = "currency", action = "store",
    help = "Initial currency"
)
ap.add_argument(
    "-p", "--common-password", dest = "password", action = "store",
    help = "Password"
)
ap.add_argument(
    "-N", "--common-pin", dest = "pin", action = "store",
    help = "PIN"
)
args = ap.parse_args()
login_name_prefix = args.login_name_prefix
number_of_primids = int(args.number_of_primids)
zpad = math.ceil(math.log10(number_of_primids))
parent_namespace_hrns = args.namespace
currency_hrns = args.currency
password = args.password
pin = args.pin

if (login_name_prefix is None):
    print("\nPlease specify a valid username prefix\n")
    ap.print_help()
    sys.exit()
elif not re_slatename.match(login_name_prefix):
    print(login_name_prefix + " is not a valid username\n")
    ap.print_help()
    sys.exit()

if currency_hrns is None:
    print("\nNo currency specified\n")
    ap.print_help()
    sys.exit()

parent_namespace_fph, parent_namespace_hrns, etypes, \
m = identify_entity(parent_namespace_hrns)
if not parent_namespace_fph:
    print("\nParent namespace not registered\n")
    ap.print_help()
    sys.exit()
if not ("namespace" in etypes):
    print("\nNamespace not registered at " + parent_namespace_hrns)
    ap.print_help()
    sys.exit()

currency_fph, currency_hrns, etypes, \
m = identify_entity(currency_hrns)
if not currency_fph:
    print("\nCurrency is not registered\n")
    ap.print_help()
    sys.exit()
if not ("currency" in etypes):
    print("\nCurrency not registered at " + currency_hrns)
    ap.print_help()
    sys.exit()

if not re_pin.match(pin):
    print("\nInvalid PIN\n")
    ap.print_help()
    sys.exit()

for i in range(int(number_of_primids)):
    login_name = login_name_prefix + str(i).zfill(zpad)
    primid_fph, primid_hrns, access_token, \
    m = new_primid(
            login_name, parent_namespace_fph, "", em1, "",
            password, pin, currency_fph
        )
    record_private_namespace_root(primid_fph, primid_fph)
    if m:
        print(m)
    print(primid_hrns)
