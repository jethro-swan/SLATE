from app.core.constants import SLATE_TEMP

#==============================================================================
# Set command line options:

ap = argparse.ArgumentParser(description = "Import a CSV dataset")
ap.add_argument(
    "-a", "--login-identity", dest = "login_identity", action = "store",
    help = "Login identity of the agent uploading this CSV file"
)
ap.add_argument(
    "-s", "--field-separator", help = "CSV field-separator (default is comma)",
    dest = "field_separator", action = "store",
    default = "comma"
)
ap.add_argument(
    "-r", "--display-report", help = "Display report of entities created",
    dest = "show_report", action = "store_true"
)
args = ap.parse_args()

tfpath = SLATE_TEMP + "/" + random_filename()

#-------------------------------------------------------------------------------

errors = []
report = []

primid_fph, primid_hrns, etypes, m = identify_entity(args.login_identity)

field_separator = args.field_separator
if not(field_separator in ["comma", "colon", "semicolon", "tab"]):
    field_separator = "comma"

if field_separator == "colon":
    SC = ":"
elif field_separator == "semicolon":
    SC = ";"
elif field_separator == "tab":
    SC = "\t"
else:
    SC = ","

with open(tfpath, "w") as temp_file:
    for row in sys.stdin:
        temp_file.write(row)

report, errors = import_csv_dataset(tfpath, primid_fph)

os.unlink(tfpath)

if args.show_report:
    for line in report:
        print(line)

for line in errors:
    print(line)
