#------------------------------------------------------------------------------
# HUB CONFIGURATION FILE
#
# The contents of this file (other than # comments or empty lines) are read at
# installation time (when ~/initialize.py is run) and saved in a DBM map. The
# value (at the right) is accessed using the key (at the left) as the argument
# for the  get_config( )  function - e.g.
#   hub_url = get_config("hub_url")
#------------------------------------------------------------------------------

# This is the URL of the host, needed for the creation of QR-coded invitations:
hub_url = https://locus02.lrc.org.uk
#hub_url = https://locus01.lrc.org.uk

# The operational mode of this hub:
hub_mode = slate
#hub_mode = nests

# This is the default lifespan of a QR-coded invitation (in seconds):
qr_code_lifespan = 31536000

# This is the email address appearing as the sender when issuing an access
# recovery link:
hub_email_account = server@lrc.org.uk

# If the following is TRUE, all accounts of the same category (typically those
# of a metrically equivalent type) belong to a specified user can be summed and
# displayed to their owner:
intracategory_account_summation = TRUE

# In its most basic mode of operation, SLATE displays only the pairings of
# *currencies* and *account-holder identities* (*ahid*), but each such pairing
# indexes an *account* the identifier of which is (by default) created
# automatically from those of the *currency* and *ahid*. Such identifiers are
# ugly and therefore generally hidden from the user, but if the following is
# TRUE they will be displayed:
display_account_identifiers = FALSE

# If the following is TRUE, the user may specify a less ugly identifier for
# such *accounts*:
specify_account_name = FALSE

# If the following is TRUE, the HRNS of the clade (private *namespace* tree)
# will be masked from the HRNS of each entity. This is intended to be helpful
# when introducing new users in the (probable) situation where all entities are
# within the same clade, but it might cause confusion for using operating among
# multiple clades. Therefore it will be ignored unless the following parameter
# (training_wheels) is also TRUE.
hide_clade_hrns = TRUE

# If the following is TRUE, most features will be hidden from the user
# interface:
training_wheels = TRUE

sandbox_clade_hrns = "cc"

# If the following is TRUE, a payment may be made directly from an *account* to
# another *account* (without having to specify an *ahid* and *currency*):
interaccount_payment_allowed = TRUE

# If the following is TRUE, the user may import a CSV dataset:
allow_user_dataset_csv_import = TRUE

# If the following is TRUE, vector currency support is enabled:
vector_currency_support_enabled = TRUE

# If the following is TRUE, interactive robots ill be active:
robots_enabled = TRUE

# Different hosts may expose different user interfaces. The options are:
# slate - used typically for basic open money applications
# nests - required for more sophisticated open measure applications
# user_choice - either of the above if permitted by the stewards of the
# *namespace* in which this user is registered.
user_interface = slate

# If the following is TRUE, in basic open money operations the agents *account*
# balances will be plotted on a parabolic canvas similar to that used in the
# LETSplay game:
scatter_plotting = TRUE

show_more_link = FALSE

currency_creation_form_full = FALSE

votes_enabled = FALSE

counts_enabled = FALSE
